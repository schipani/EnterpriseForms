<Project Sdk="Microsoft.NET.Sdk">
  <!--
    E3-M2e-1 data-key ledger real-PostgreSQL gate (legacy agent: one Prepare or Commit of a frozen Authority build per process;
    LegacyBinaries = that build's Authority Release binaries: 8915f77 for CARV 1, a1127a1 for CARV 2). Development/Testing only; not part
    of EnterpriseForms.All.slnx and never built in place: scripts/dev/e3-m2e1-ledger-pg-gate.ps1 copies this folder to a temporary work
    directory (outside the repository, so no repository build settings apply) and builds it there. It references no repository project.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LegacyAgent</AssemblyName>
    <!-- Without a deps file the host loads every assembly in the output folder: the copies of LegacyBinaries. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS1591;CA2007;CA1303</NoWarn>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="$(LegacyBinaries)\*.dll" Private="true" />
  </ItemGroup>
  <Target Name="RequireLegacyBinaries" BeforeTargets="ResolveAssemblyReferences" Condition="'$(LegacyBinaries)' == '' Or !Exists('$(LegacyBinaries)\AuthorizationAuthority.Api.dll')">
    <Error Text="Build through scripts/dev/e3-m2e1-ledger-pg-gate.ps1 (LegacyBinaries must name a folder of Authority Release binaries)." />
  </Target>
</Project>
