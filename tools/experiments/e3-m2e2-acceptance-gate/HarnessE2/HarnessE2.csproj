<Project Sdk="Microsoft.NET.Sdk">
  <!--
    E3-M2e-2 controlled Envelope v2 acceptance verification (docs/security/E3_M2E2_VERIFICATION_RECORD.md). Development/Testing only;
    TEST-ONLY. Not part of EnterpriseForms.All.slnx and never built in place: scripts/dev/e3-m2e2-acceptance-pg-gate.ps1 copies this
    folder to a temporary work directory (outside the repository, so no repository build settings apply) and builds it against ONE
    merged folder of Release binaries (M2e2Binaries): this tree's Authority (AuthorizationAuthority.*) plus this tree's business
    Domain/Application/Infrastructure (the real E3-M1 Envelope v2 core and the business signed-column registry) and EnterpriseForms.Integrity.
    The script refuses to merge two different versions of one assembly. It references no repository project.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>M2e2Harness</AssemblyName>
    <!-- Without a deps file the host loads every assembly in the output folder: the copies of M2e2Binaries. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS1591;CA2007;CA1303;CS0436</NoWarn>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="$(M2e2Binaries)\*.dll" Private="true" />
  </ItemGroup>
  <Target Name="RequireM2e2Binaries" BeforeTargets="ResolveAssemblyReferences" Condition="'$(M2e2Binaries)' == '' Or !Exists('$(M2e2Binaries)\AuthorizationAuthority.Api.dll') Or !Exists('$(M2e2Binaries)\EnterpriseForms.Infrastructure.dll')">
    <Error Text="Build through scripts/dev/e3-m2e2-acceptance-pg-gate.ps1 (M2e2Binaries must name the merged Authority + business Release binaries)." />
  </Target>
</Project>
