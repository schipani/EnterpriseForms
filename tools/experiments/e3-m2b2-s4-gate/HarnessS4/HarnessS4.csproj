<Project Sdk="Microsoft.NET.Sdk">
  <!--
    E3-M2b-2 R-M2b2-11 focused real-PostgreSQL gate for the Authority S-4 schema/envelope tie (contract §23.15). Development/Testing
    only; not part of EnterpriseForms.All.slnx and never built in place: scripts/dev/e3-m2b2-s4-pg-gate.ps1 copies this folder to a
    temporary work directory (outside the repository, so no repository build settings apply) and builds it against this tree's
    Authority Release binaries passed as S4Binaries. It references no repository project.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>S4Harness</AssemblyName>
    <!-- Without a deps file the host loads every assembly in the output folder: the byte-identical copies of S4Binaries. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS1591;CA2007;CA1303</NoWarn>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="$(S4Binaries)\*.dll" Private="true" />
  </ItemGroup>
  <Target Name="RequireS4Binaries" BeforeTargets="ResolveAssemblyReferences" Condition="'$(S4Binaries)' == '' Or !Exists('$(S4Binaries)\AuthorizationAuthority.Api.dll')">
    <Error Text="Build through scripts/dev/e3-m2b2-s4-pg-gate.ps1 (S4Binaries must name a folder of Authority Release binaries)." />
  </Target>
</Project>
