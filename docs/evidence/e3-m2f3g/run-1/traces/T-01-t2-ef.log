SET LOCAL lock_timeout = '1s'
SELECT a.organization_authorization_state_id, a.audit_journal_revision, a.authorization_revision, a.checkpoint_enforcement_mode_name, a.content_integrity_revision, a.integrity_quarantine_enabled, a.integrity_quarantine_reason_code, a.latest_audit_journal_digest, a.latest_content_journal_digest, a.latest_security_journal_digest, a.projection_zed_token, a.organization_display_name, a.organization_id, a.organization_onboarding_request_id, a.projection_applied_revision, a.projection_worker_fencing_epoch, a.projection_snapshot_zed_token, a.state_modified_on
FROM (
    SELECT * FROM authority.organization_authorization_states WHERE organization_id = @p0 FOR UPDATE
) AS a
LIMIT 1
SET LOCAL statement_timeout = '500ms'
UPDATE authority.organization_authorization_states SET audit_journal_revision = @p0, latest_audit_journal_digest = @p1, state_modified_on = @p2
WHERE organization_authorization_state_id = @p3;
INSERT INTO authority.security_journal_entries (security_journal_entry_id, archive_attempt_count, archive_delivery_state, archive_receipt_digest, archive_receipt_reference, content_change_operation_id, journal_archived_on, journal_created_on, journal_event_body_json, journal_event_digest, journal_event_kind, journal_previous_digest, journal_stream_name, journal_stream_revision, last_archive_error_code, organization_id, security_command_id)
VALUES (@p4, @p5, @p6, @p7, @p8, @p9, @p10, @p11, @p12, @p13, @p14, @p15, @p16, @p17, @p18, @p19, @p20);

