diff --git a/src/authority/AuthorizationAuthority.Application/Common/P1Probe.cs b/src/authority/AuthorizationAuthority.Application/Common/P1Probe.cs
new file mode 100644
index 0000000..d70108a
--- /dev/null
+++ b/src/authority/AuthorizationAuthority.Application/Common/P1Probe.cs
@@ -0,0 +1,9 @@
+namespace AuthorizationAuthority.Application.Common;
+
+// THROWAWAY P-S1-1 timing probe (never committed).
+internal sealed class P1Probe
+{
+    public static readonly System.Threading.AsyncLocal<P1Probe?> Current = new();
+    public long SpiceTicks, SpiceCalls, SpiceItems, MacTicks, MacCalls, PinTicks, CompleteTicks, LoopTicks;
+    public static double Ms(long ticks) => ticks * 1000.0 / System.Diagnostics.Stopwatch.Frequency;
+}
