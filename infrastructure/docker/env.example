# Copy to .env (git-ignored). SYNTHETIC DEVELOPMENT CREDENTIALS ONLY — never reuse outside the local Compose stack.
# Business and authority databases deliberately use different administrative credentials AND different runtime roles (ADR-PB-005 §4, G08).
BUSINESS_DB_NAME=enterpriseforms_business
BUSINESS_DB_ADMIN_USER=business_admin_dev
BUSINESS_DB_ADMIN_PASSWORD=business-dev-only-change-me
BUSINESS_RUNTIME_USER=business_api_runtime
BUSINESS_RUNTIME_PASSWORD=business-runtime-dev-only-change-me

AUTHORITY_DB_NAME=enterpriseforms_authority
AUTHORITY_DB_ADMIN_USER=authority_admin_dev
AUTHORITY_DB_ADMIN_PASSWORD=authority-dev-only-change-me
AUTHORITY_RUNTIME_USER=authority_runtime
AUTHORITY_RUNTIME_PASSWORD=authority-runtime-dev-only-change-me

SPICEDB_DB_USER=spicedb_dev
SPICEDB_DB_PASSWORD=spicedb-dev-only-change-me
SPICEDB_PRESHARED_KEY=spicedb-dev-preshared-key-change-me

# Vault dev mode root token (development only; Vault dev mode has no persistence or isolation). Held ONLY by the authority container.
VAULT_DEV_ROOT_TOKEN=dev-only-token

# Independent security-event archive test double (Azurite on authority-net). Well-known Azurite dev account key.
ARCHIVE_ACCOUNT_NAME=devstoreaccount1
ARCHIVE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==

# Service-to-service credentials (HS256 shared secrets, ≥32 bytes base64). Workload ≠ operator ≠ user-assertion key.
WORKLOAD_ISSUER=enterpriseforms-business-api
WORKLOAD_AUDIENCE=authorization-authority
WORKLOAD_SHARED_KEY_BASE64=d29ya2xvYWQtZGV2LW9ubHktc2hhcmVkLWtleS0wMDAwMDAwMDAwMA==
OPERATOR_ISSUER=authority-operator
OPERATOR_AUDIENCE=authorization-authority-operator
OPERATOR_SHARED_KEY_BASE64=b3BlcmF0b3ItZGV2LW9ubHktc2hhcmVkLWtleS0wMDAwMDAwMDAwMA==
# TestIdentityProvider (Development/Testing only; PB-08 Entra BFF replaces it). Business API validates user tokens with it;
# the authority validates the forwarded assertion independently with the same issuer key.
TEST_IDP_ISSUER=https://test-idp.enterpriseforms.invalid
TEST_IDP_AUDIENCE=enterpriseforms
TEST_IDP_SHARED_KEY_BASE64=dGVzdC1pZHAtZGV2LW9ubHktc2lnbmluZy1rZXktMDAwMDAwMDAwMA==

BUSINESS_ENVIRONMENT=Development
AUTHORITY_ENVIRONMENT=Development

# Stage B (B-05): documents. Local development KEK (32 bytes base64) for the LocalDevelopment key provider — Development/Testing only;
# Azure Key Vault / Managed HSM providers are required (and not yet implemented) elsewhere. ClamAV clamd provides real scan verdicts.
LOCAL_DEV_KEK_BASE64=bG9jYWwtZGV2LW9ubHkta2VrLTAwMDAwMDAwMDAwMDA=
DOCUMENTS_ACCOUNT_NAME=devstoreaccount1
DOCUMENTS_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
