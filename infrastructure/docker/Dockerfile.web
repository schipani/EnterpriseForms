# Web (React/Vite) image: Node build stage, unprivileged nginx runtime. SPA fallback only for /app, never for /api.
FROM node:22-alpine AS build
WORKDIR /src
COPY src/frontend/package.json src/frontend/package-lock.json ./
COPY src/frontend/apps/web/package.json apps/web/
COPY src/frontend/packages/design-tokens/package.json packages/design-tokens/
COPY src/frontend/packages/api-client/package.json packages/api-client/
# npm ci can fail to materialize platform-specific optional native bindings (e.g. rolldown's
# linux-x64-musl build) when package-lock.json was generated on a different OS; this is the
# documented npm bug https://github.com/npm/cli/issues/4828. `npm install` re-resolves optional
# dependencies for the actual build platform instead of trusting the cross-platform lockfile entry.
RUN npm install --ignore-scripts
COPY src/frontend/ ./
COPY contracts/ /contracts/
RUN npm run build -w apps/web

FROM nginxinc/nginx-unprivileged:1.29-alpine AS runtime
COPY infrastructure/docker/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
