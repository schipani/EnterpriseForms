# Web (React/Vite) image: Node build stage, unprivileged nginx runtime. SPA fallback only for /app, never for /api.
FROM node:22-alpine AS build
WORKDIR /src
COPY src/frontend/package.json src/frontend/package-lock.json ./
COPY src/frontend/apps/web/package.json apps/web/
COPY src/frontend/packages/design-tokens/package.json packages/design-tokens/
COPY src/frontend/packages/api-client/package.json packages/api-client/
RUN npm ci --ignore-scripts
COPY src/frontend/ ./
COPY contracts/ /contracts/
RUN npm run build -w apps/web

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY infrastructure/docker/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
