# Platform Console web image (C8 M2 Stage 4): static SPA + nginx that proxies /console-api to the Platform Console BFF on the same
# origin (so the BFF cookie, CSRF and Origin checks all hold). Separate image and origin from the business web app.
FROM node:25-alpine AS build
WORKDIR /src
COPY src/frontend/package.json src/frontend/package-lock.json ./
COPY src/frontend/apps/platform-console/package.json apps/platform-console/
COPY src/frontend/packages/design-tokens/package.json packages/design-tokens/
COPY src/frontend/packages/ui/package.json packages/ui/
# `npm install` (not ci) re-resolves platform-specific optional bindings, as in Dockerfile.web (npm/cli#4828).
RUN npm install --ignore-scripts
COPY src/frontend/ ./
RUN npm run build -w apps/platform-console

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY infrastructure/docker/nginx.platform-console-web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/platform-console/dist /usr/share/nginx/html
EXPOSE 8080
