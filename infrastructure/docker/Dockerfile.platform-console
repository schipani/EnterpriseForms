# Platform Console BFF image (C8 M2 Stage 3). SEPARATELY deployed from the business application and the Authority: it contains only
# the console and the Authority's published wire contract — no business assembly, no Authority logic, no key material.
# Development/Testing only until PB-08; the PB-11 security pipeline would build, sign and promote it separately.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props ./
COPY src/authority/AuthorizationAuthority.Contracts/AuthorizationAuthority.Contracts.csproj src/authority/AuthorizationAuthority.Contracts/
COPY src/platform-console/EnterpriseForms.PlatformConsole/EnterpriseForms.PlatformConsole.csproj src/platform-console/EnterpriseForms.PlatformConsole/
RUN dotnet restore src/platform-console/EnterpriseForms.PlatformConsole/EnterpriseForms.PlatformConsole.csproj
COPY src/authority/AuthorizationAuthority.Contracts/ src/authority/AuthorizationAuthority.Contracts/
COPY src/platform-console/ src/platform-console/
RUN dotnet publish src/platform-console/EnterpriseForms.PlatformConsole/EnterpriseForms.PlatformConsole.csproj -c Release -o /app/publish --no-restore -p:OpenApiGenerateDocumentsOnBuild=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled AS runtime
WORKDIR /app
COPY --from=build /app/publish ./
ENV ASPNETCORE_URLS=http://0.0.0.0:8080 \
    DOTNET_EnableDiagnostics=0
EXPOSE 8080
USER $APP_UID
ENTRYPOINT ["dotnet", "EnterpriseForms.PlatformConsole.dll"]
