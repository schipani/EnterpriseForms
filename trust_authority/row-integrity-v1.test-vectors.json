  "negativeCases": [
    {
      "caseId": "ROWV1-NEG-NULL-IN-NON-NULLABLE",
      "description": "NULL supplied for non-nullable boolean_flag.",
      "expectedError": "NullNotPermitted"
    },
    {
      "caseId": "ROWV1-NEG-JSON-FLOAT",
      "description": "json_value containing 1.5 (float) is rejected in v1.",
      "expectedError": "JsonFloatNotPermitted"
    },
    {
      "caseId": "ROWV1-NEG-JSON-NON-ASCII-KEY",
      "description": "json_value with key '\\u00e9' is rejected in v1.",
      "expectedError": "JsonKeyNotAscii"
    },
    {
      "caseId": "ROWV1-NEG-UNSORTED-REGISTRY",
      "description": "A schema whose signed columns are not ASCII-sorted is rejected at registry load.",
      "expectedError": "RegistryNotSorted"
    },
    {
      "caseId": "ROWV1-NEG-EXTRA-COLUMN",
      "description": "A value for a column absent from the registry is rejected (no silent extension).",
      "expectedError": "UnregisteredColumn"
    },
    {
      "caseId": "ROWV1-NEG-MISSING-COLUMN",
      "description": "Omitting a registered column is rejected (absent is not NULL).",
      "expectedError": "MissingColumn"
    },
    {
      "caseId": "ROWV1-NEG-NAIVE-TIMESTAMP",
      "description": "Timestamp without explicit offset is rejected.",
      "expectedError": "TimestampOffsetRequired"
    },
    {
      "caseId": "ROWV1-NEG-ROW-REVISION-ZERO",
      "description": "row_revision 0 is rejected (first revision is 1).",
      "expectedError": "RowRevisionRange"
