// Authorization Authority SpiceDB schema (Stage A). Derived from trust_authority/spicedb.schema.zed with the
// projection-cursor marker required by CROSS_SYSTEM_CONSISTENCY_PROTOCOL.md section 5 (marker CAS).
// Object ids are RFC 4122 UUID strings issued by the authority; the business API never writes relationships.

definition user {}

// Cursor marker objects: "step-<organization uuid>-<revision>". Never a permission subject.
definition projection_step {}

definition team {
    relation member: user
    permission participant = member
}

definition organization {
    relation organization_owner: user
    relation system_administrator: user
    relation designer: user
    relation projection_cursor: projection_step
    permission manage_configuration = organization_owner
    permission administer_security = system_administrator
    permission create_form = designer
}

definition form_definition {
    relation organization: organization
    relation designer: user | team#participant
    relation form_user: user | team#participant
    permission design = designer
    permission create_record = form_user
}

definition record_share {
    relation reader: user | team#participant
    relation contributor: user | team#participant
    relation manager: user | team#participant
    permission read = reader + contributor + manager
    permission edit = contributor + manager
    permission delegate = manager
}

// Child records (Stage B, B-04) carry a parent edge instead of an owner edge: every permission derives from the
// parent's corresponding permission, so revoking the parent revokes the child and a parent share does NOT reach
// child fields (field_item/document_item consult the child's own owner/parent chain, never the parent's shares).
definition form_record {
    relation organization: organization
    relation owner: user | team#participant
    relation parent: form_record
    relation shared_via: record_share
    permission effective_owner = owner + parent->effective_owner
    permission discover = effective_owner + shared_via->read
    permission read = effective_owner
    permission edit = effective_owner
    permission manage_access = effective_owner + shared_via->delegate
    permission transfer_ownership = owner
}

definition field_item {
    relation parent_record: form_record
    relation shared_via: record_share
    permission read = parent_record->effective_owner + shared_via->read
    permission edit = parent_record->effective_owner + shared_via->edit
    permission delegate = parent_record->effective_owner + shared_via->delegate
}

definition document_item {
    relation parent_record: form_record
    relation shared_via: record_share
    permission read = parent_record->effective_owner + shared_via->read
    permission replace = parent_record->effective_owner + shared_via->edit
    permission delegate = parent_record->effective_owner + shared_via->delegate
}
