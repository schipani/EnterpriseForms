{
  "name": "enterpriseforms-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Enterprise Forms web workspace: app shell plus feature-owned packages (ADR-ARCH-001 §4U.4). Toolchain pinned per ADR-PB-011.",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "generate:api-client": "npm run generate -w packages/api-client",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.15",
    "@rolldown/binding-linux-x64-musl": "1.2.14",
    "@rolldown/binding-win32-x64-msvc": "^1.2.14",
    "lightningcss-linux-x64-gnu": "^1.33.0",
    "lightningcss-linux-x64-musl": "1.33.0",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
