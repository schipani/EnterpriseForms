<Project Sdk="Microsoft.NET.Sdk">
  <!-- Port adapters and EF Core mappings grouped by owning feature; single business DbContext and migration stream. -->
  <PropertyGroup>
    <RootNamespace>EnterpriseForms.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EnterpriseForms.Application/EnterpriseForms.Application.csproj" />
    <ProjectReference Include="../EnterpriseForms.Domain/EnterpriseForms.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EnterpriseForms.Api.ContractTests" />
  </ItemGroup>

</Project>
