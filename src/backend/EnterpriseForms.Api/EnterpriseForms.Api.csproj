<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Business API/BFF composition root. Minimal APIs under /api/v1 registered per feature.
    The OpenAPI document is generated from compiled endpoints at build time into contracts/openapi/
    (ADR-PB-006: compiled endpoints are the sole source of the published contract).
  -->
  <PropertyGroup>
    <RootNamespace>EnterpriseForms.Api</RootNamespace>
    <UserSecretsId>enterpriseforms-api-dev</UserSecretsId>
    <OpenApiDocumentsDirectory>$(RepositoryRoot)contracts/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name enterprise-forms-v1</OpenApiGenerateDocumentsOptions>
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EnterpriseForms.Application/EnterpriseForms.Application.csproj" />
    <ProjectReference Include="../EnterpriseForms.Infrastructure/EnterpriseForms.Infrastructure.csproj" />
    <ProjectReference Include="../EnterpriseForms.Contracts/EnterpriseForms.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EnterpriseForms.Api.ContractTests" />
  </ItemGroup>
</Project>
